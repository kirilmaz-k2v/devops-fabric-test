<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <!-- External libraries of the project. buildArtifacts.sh downloads the compile and runtime scopes
       through Maven (Nexus) to the compile classpath and lib/ in every LU's ludbXMLs.zip -->
  <groupId>com.k2view.projects</groupId>
  <artifactId>devops-fabric-test</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <dependencies>
    <!-- In-house jar, previously committed to lib/; now published to Nexus maven-releases -->
    <dependency>
      <groupId>com.customer</groupId>
      <artifactId>customer-utils</artifactId>
      <version>1.0.0</version>
    </dependency>
    <!-- provided scope is not downloaded or packaged (the lab shows it is not visible to an LU at runtime) -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
